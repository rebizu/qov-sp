<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:QovGui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="QovGui.Views.RecorderView"
             x:DataType="vm:RecorderViewModel">
  
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
      <StackPanel Grid.Row="0" Spacing="10">
          <TextBlock Text="Video Source"/>
          <ComboBox ItemsSource="{Binding VideoDevices}" SelectedItem="{Binding SelectedVideoDevice}" HorizontalAlignment="Stretch"/>
          
          <TextBlock Text="Audio Source"/>
          <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" HorizontalAlignment="Stretch"/>
      </StackPanel>
      
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="Bold" Margin="0,20"/>
      </StackPanel>

      <Button Grid.Row="2" Command="{Binding ToggleRecordingCommand}" HorizontalAlignment="Center" Padding="20,10">
          <Panel>
              <TextBlock Text="Start Recording" IsVisible="{Binding !IsRecording}"/>
              <TextBlock Text="Stop Recording" IsVisible="{Binding IsRecording}" Foreground="Red"/>
          </Panel>
      </Button>
  </Grid>
</UserControl>
