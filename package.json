{
  "name": "qov-recorder-player",
  "version": "1.0.0",
  "description": "QOV (Quite OK Video) recorder and player",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx tsc && npx vite build",
    "preview": "npx vite preview",
    "corpus": "python3 qov-analysis-tools/gen_corpus.py || python qov-analysis-tools/gen_corpus.py",
    "conformance": "python3 qov-analysis-tools/conformance.py || python qov-analysis-tools/conformance.py",
    "review": "esbuild qov-analysis-tools/review_suite.ts --bundle --platform=node --format=cjs --outfile=qov-analysis-tools/review_suite.cjs --log-level=warning && node qov-analysis-tools/review_suite.cjs",
    "selftest": "esbuild qov-analysis-tools/qovs_selftest.ts --bundle --platform=node --format=cjs --outfile=qov-analysis-tools/qovs_selftest.cjs --log-level=warning && node qov-analysis-tools/qovs_selftest.cjs",
    "relay": "node tools/qovs-relay.mjs"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "ws": "^8.21.3"
  }
}
